# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/eventpilot

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Server ────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ── CORS ──────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── LLM ──────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL_2=gemini-2.5-flash-lite
LLM_MODE=live
LLM_MODEL_PLANNER=gemini-3.8-flash
LLM_MODEL_EXTRACT=gemini-3.8-flash
LLM_MAX_CALLS_PER_EVENT_PER_HOUR=100
LLM_DAILY_TOKEN_CAP=1000000
LLM_CACHE_TTL_SECONDS=3600
ANTHROPIC_API_KEY=

# ── Notifications ────────────────────────────────────────────────────
NOTIFY_MODE=dry-run
TWILIO_ACCOUNT_SID=PLACEHOLDER
TWILIO_AUTH_TOKEN=PLACEHOLDER
TWILIO_FROM_NUMBER=+1234567890
NOTIFY_ALLOWLIST=

# ── Uploads ──────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_DOC_SIZE_MB=10
MAX_IMAGE_SIZE_MB=5

# ── Rate Limiting ────────────────────────────────────────────────────
RATE_LIMIT_GLOBAL_PER_MINUTE=100
RATE_LIMIT_LLM_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10
